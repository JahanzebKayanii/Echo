{
  "manifest_version": 3,
  "name": "Echo – Meeting Recorder",
  "version": "1.0.0",
  "description": "Record any meeting and send it straight to Echo for transcription and AI analysis.",
  "permissions": ["storage", "microphone", "tabs"],
  "host_permissions": [
    "https://echo-silk-one.vercel.app/*",
    "https://echo-api-hfq5.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://echo-silk-one.vercel.app/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
